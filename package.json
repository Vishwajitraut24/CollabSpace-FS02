{
  "name": "collabspace-realtime-workspace",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently -n web,api -c cyan,green \"npm:dev:web\" \"npm:dev:api\"",
    "dev:web": "npm --workspace apps/web run dev",
    "dev:api": "npm --workspace apps/collaboration-server run dev",
    "build": "npm --workspace apps/web run build && npm --workspace apps/collaboration-server run build",
    "db:generate": "prisma generate --schema apps/collaboration-server/prisma/schema.prisma",
    "db:migrate": "prisma migrate dev --schema apps/collaboration-server/prisma/schema.prisma",
    "db:deploy": "prisma migrate deploy --schema apps/collaboration-server/prisma/schema.prisma",
    "db:seed": "tsx apps/collaboration-server/prisma/seed.ts",
    "test": "npm --workspace apps/collaboration-server test"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "typescript": "^5.7.3"
  },
  "overrides": {
    "postcss": "^8.5.23"
  },
  "allowScripts": {
    "@prisma/client@6.12.0": true,
    "@prisma/engines@6.12.0": true,
    "prisma@6.12.0": true,
    "esbuild@0.28.2": true,
    "classic-level@1.4.1": true,
    "leveldown@5.6.0": true
  },
  "dependencies": {
    "@prisma/client": "^6.12.0"
  }
}
